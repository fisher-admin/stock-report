- __pycache__/
- node_modules/
- .venv*/
- .pytest_cache/
- .DS_Store
- *.pyc
- *.parquet
- *.npz
- *.npy
- *.pkl
- *.pickle
- *.db
- *.sqlite*
- *.env
- .env*
- *.pem
- *.key
- *.p12
- *.crx
- *.log
- *.gz
- *.zip
- *.tar
- *.bak-*
- *.skill
- /docs/superpowers/reviews/evidence/
